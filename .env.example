DISCORD_TOKEN=MTUyMjczNjk0NjUyMTMwOTM3Ng.GHx-3m._8_iBrP3JuqM2NEElzcE1sA1yZC7dVRrr0IrnE
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.5
COMMAND_PREFIX=!

# Optional: comma-separated Discord guild IDs. Leave empty for all guilds.
CAINE_ALLOWED_GUILD_IDS=

# Optional: comma-separated role names that may evolve/approve plugins.
CAINE_ADMIN_ROLE_NAMES=CAINE Admin,Admin

# Optional: comma-separated role IDs that may evolve/approve plugins.
CAINE_ADMIN_ROLE_IDS=

# Load approved plugins automatically on startup.
CAINE_PLUGIN_AUTOLOAD=true

# Trusted mode: approved plugins run with full Python/Discord access.
# Set this to true only when you intentionally trust approved plugin code.
CAINE_TRUSTED_PLUGINS=false
